# Copy this file to .env and replace the placeholder values:
#   cp .env.example .env

# 'development' or 'production'
MATRIX_MODE=development

# Connection string for data storage
DATABASE_URL=postgresql://neo:your_password@localhost:5432/matrix

# Secret key for external services
API_KEY=your_api_key_here

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=DEBUG

# URL for the resistance network
ZION_ENDPOINT=https://zion.example.com/api
